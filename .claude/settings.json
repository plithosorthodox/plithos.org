      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(base64:*)",
      "Bash(gzip:*)",
      "Bash(gunzip:*)",
      "Bash(zcat:*)",
      "Bash(curl:*)",
      "Bash(date:*)",
      "Bash(which:*)",
      "Bash(true)",
      "Bash(rm batch.txt)",
      "Bash(rm -f batch.txt)",
      "Bash(rm *.bak)",
      "Bash(rm -f *.bak)",
      "Bash(python3 -m http.server:*)",
      "Read",
      "Glob",
      "Grep",
      "Write",
      "Edit",
      "TodoWrite",
      "WebFetch",
      "WebSearch"
