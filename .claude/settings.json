      "Bash(test:*)",
      "Bash(sleep:*)",
      "Bash(timeout:*)",
      "Bash(comm:*)",
      "Bash(paste:*)",
      "Bash(fold:*)",
      "Bash(iconv:*)",
      "Bash(md5sum:*)",
      "Bash(sha256sum:*)",
      "Bash(git cat-file:*)",
      "Bash(git ls-remote:*)",
      "Bash(git worktree list)",
      "Bash(git count-objects:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(node:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(file:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
