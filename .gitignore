# OS cruft
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*~
.netrwhist

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Environment / secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# Dependency + build output (in case a toolchain is added later)
node_modules/
dist/
build/
.cache/
.parcel-cache/
.next/
.astro/
_site/
public/build/

# Deploy tooling
.netlify/
.vercel/
.wrangler/

# Claude Code local overrides (machine-specific, not shared)
.claude/settings.local.json

__pycache__/
*.pyc

# The copy tools/build_ui_i18n.py leaves beside a page before rewriting it.
# It is the page itself, three megabytes of it, and .assetsignore does not
# cover it - committed, it would be uploaded and served.
*.bak

# scratch from tools/check_i18n.py, left behind when a run is killed
*.i18n-eval.js
