# Plithos caching
#
# HTML is revalidated every visit so deploys land immediately.
#
# Cloudflare Pages applies EVERY matching rule and concatenates the results,
# so a path must match only one Cache-Control block. /data/*.json used to
# match both /data/* and /*.json, which produced a malformed doubled header
# ("max-age=31536000, immutable, public, max-age=604800"). The rules below
# are written so that cannot happen: there is no bare /*.json rule, and the
# per-page rules that duplicated /*.html are gone.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/*.html
  Cache-Control: no-cache, must-revalidate

# Cloudflare serves each page at its extensionless path too, and /*.html does
# NOT match those. Without these rules the routes inherit a default TTL, and a
# stale copy can outlive a deploy - which is exactly what happened when
# /prayers was still an alias for the calendar.
/
  Cache-Control: no-cache, must-revalidate
/saints
  Cache-Control: no-cache, must-revalidate
/library
  Cache-Control: no-cache, must-revalidate
/prayers
  Cache-Control: no-cache, must-revalidate
/glossary
  Cache-Control: no-cache, must-revalidate
/rule
  Cache-Control: no-cache, must-revalidate
/contact
  Cache-Control: no-cache, must-revalidate

# The build now published. Every page carries the build it was published as,
# and the shared UI layer refetches a page whose stamp does not match this.
# It is the one file that must never be held by anything, at any layer.
/version.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# Versioned content bundles. The filename carries the version, so these are
# safe to cache hard. Bump the version in the FILENAME when the content
# changes; never relax this header.
/data/prayers-i18n.v1.*
  Cache-Control: public, max-age=31536000, immutable

/data/bible.v1.*
  Cache-Control: public, max-age=31536000, immutable

/data/search-index.v4.json
  Cache-Control: public, max-age=31536000, immutable

# The words the shared chrome says, in each language. English is inside the
# shared script and needs no file; the English file here is the sheet a
# translator copies. Versioned, so it can be cached hard.
/data/ui-i18n.v1.*
  Cache-Control: public, max-age=31536000, immutable

# v1 to v3 are frozen, not dead. Each was served immutable for a year, so a
# browser that has already fetched one will keep it, and pages held from before
# the shared script was bumped still ask for that exact name. Leaving them in
# place costs 300 KB apiece and means those pages get a working palette with
# slightly older results, instead of the 6.8 MB catch-all. Never edit them:
# bump the version.
/data/search-index.v3.json
  Cache-Control: public, max-age=31536000, immutable

/data/search-index.v2.json
  Cache-Control: public, max-age=31536000, immutable

/data/search-index.v1.json
  Cache-Control: public, max-age=31536000, immutable

/data/prayers.v2.json
  Cache-Control: public, max-age=31536000, immutable

/data/glossary.v2.json
  Cache-Control: public, max-age=31536000, immutable

/data/glossary-i18n.v1.*
  Cache-Control: public, max-age=31536000, immutable

/data/flags.v1.json
  Cache-Control: public, max-age=31536000, immutable

/data/rule-i18n.v3.*
  Cache-Control: public, max-age=31536000, immutable

# Frozen, not dead: each was served immutable for a year, so pages held
# from before a bump still ask for that exact name. Never edit them.
/data/rule-i18n.v2.*
  Cache-Control: public, max-age=31536000, immutable

/data/rule-i18n.v1.*
  Cache-Control: public, max-age=31536000, immutable

# The list of languages the Rule page offers. It grows as languages are added
# and its name is fixed in the page, so it must NOT be immutable - and it must
# not match the rule above, or Cloudflare concatenates both values into one
# malformed header. Hence the different stem.
/data/rule-langs.json
  Cache-Control: public, max-age=3600, must-revalidate

# The library catalogue grows as works are added and its filename is
# hardcoded in library.html, so it must NOT be immutable.
/data/library/*
  Cache-Control: public, max-age=3600, must-revalidate

# Scripture is large and stable but carries no version in the filename.
/scripture/*
  Cache-Control: public, max-age=604800

# The shared UI layer carries a version in its filename, so it can be cached
# hard: a change ships as a new filename and no cached copy can be stale. Bump
# the version in the filename AND in all seven pages together - an unversioned
# asset behind a long edge cache is what hid the flag picker from readers for
# a day, and shortening the header does not purge what Cloudflare has already
# cached.
#
# assets/plithos-ui.js is the one deliberate exception: it is unversioned
# because pages held from an earlier day ask for that exact name, and those
# pages cannot be changed. It does nothing but bring such a page up to date.
#
# The year is a loaded gun while a deploy is landing. A request for a file the
# edge does not have yet is answered with the whole of index.html and a 200,
# and that answer is then held here for a year - which is how v3.css was lost
# a minute after it shipped. Ship the file in one commit, confirm it answers
# through a cache-busting query string, and point the pages at it in the next.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=2592000

/*.svg
  Cache-Control: public, max-age=2592000
