# Plithos caching
# HTML is revalidated every visit so deploys land immediately.
# Versioned content files under /data are immutable and cached hard.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/*.html
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/plithos_saints.html
  Cache-Control: no-cache, must-revalidate

/plithos_reader.html
  Cache-Control: no-cache, must-revalidate

# Content bundles. Filenames carry a version, so these never need revalidating.
# Bump the filename when the content changes, never the header.
/data/*
  Cache-Control: public, max-age=31536000, immutable

/scripture/*
  Cache-Control: public, max-age=604800

/*.json
  Cache-Control: public, max-age=604800

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=2592000

/*.svg
  Cache-Control: public, max-age=2592000
