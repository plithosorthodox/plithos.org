# Plithos caching
#
# HTML is revalidated every visit so deploys land immediately.
#
# Cloudflare Pages applies EVERY matching rule and concatenates the results,
# so a path must match only one Cache-Control block. /data/*.json used to
# match both /data/* and /*.json, which produced a malformed doubled header
# ("max-age=31536000, immutable, public, max-age=604800"). The rules below
# are written so that cannot happen: there is no bare /*.json rule, and the
# per-page rules that duplicated /*.html are gone.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/*.html
  Cache-Control: no-cache, must-revalidate

# Cloudflare serves each page at its extensionless path too, and /*.html does
# NOT match those. Without these rules the routes inherit a default TTL, and a
# stale copy can outlive a deploy - which is exactly what happened when
# /prayers was still an alias for the calendar.
/
  Cache-Control: no-cache, must-revalidate
/saints
  Cache-Control: no-cache, must-revalidate
/library
  Cache-Control: no-cache, must-revalidate
/prayers
  Cache-Control: no-cache, must-revalidate
/glossary
  Cache-Control: no-cache, must-revalidate
/rule
  Cache-Control: no-cache, must-revalidate
/contact
  Cache-Control: no-cache, must-revalidate

# The build now published. Every page carries the build it was published as,
# and the shared UI layer refetches a page whose stamp does not match this.
# It is the one file that must never be held by anything, at any layer.
/version.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

# Versioned content bundles. The filename carries the version, so these are
# safe to cache hard. Bump the version in the FILENAME when the content
# changes; never relax this header.
# The prayers, one file per language and 364 KB apiece. The same thing that
# happened to the New Testament happened here and was not noticed: there was
# a rule for v1 and never one for v2, so from the day the pages were bumped
# every reader in twenty-one languages revalidated 364 KB on every visit and
# re-fetched the whole of it whenever it moved. Both stems stand here now.
# The calendar's own tables and the feast names, copied out of index.html by
# tools/build_calendar_engine.py so an embeddable panel and a JSON endpoint can
# run the same reckoning. Versioned, so they cache hard; bump the version in
# the filename when the calendar changes and add the new stem here.
/data/calendar-tables.v1.json
  Cache-Control: public, max-age=31536000, immutable

/data/calendar-names.v1.*
  Cache-Control: public, max-age=31536000, immutable

/data/prayers-i18n.v2.*
  Cache-Control: public, max-age=31536000, immutable

/data/prayers-i18n.v1.*
  Cache-Control: public, max-age=31536000, immutable

# The words of the Rule page, in twenty-one languages. Same story, same fix.
/data/rule-i18n.v5.*
  Cache-Control: public, max-age=31536000, immutable

# Frozen. These stems were superseded before they ever had a rule here, so
# nothing holds them, but a page held from before a bump still asks for the
# exact name and should not be told to revalidate it every time.
/data/saint-lives.v1.*
  Cache-Control: public, max-age=3600, must-revalidate

/data/saint-lives.v2.*
  Cache-Control: public, max-age=3600, must-revalidate

/data/saint-lives.v3.*
  Cache-Control: public, max-age=3600, must-revalidate

/data/saint-lives.v4.*
  Cache-Control: public, max-age=3600, must-revalidate

/data/saint-lives.v5.*
  Cache-Control: public, max-age=3600, must-revalidate

/data/saint-terms.v1.*
  Cache-Control: public, max-age=3600, must-revalidate

/data/saint-terms.v2.*
  Cache-Control: public, max-age=3600, must-revalidate

/data/saint-terms.v3.*
  Cache-Control: public, max-age=3600, must-revalidate

/data/saint-terms.v4.*
  Cache-Control: public, max-age=3600, must-revalidate

/data/bible.v1.*
  Cache-Control: public, max-age=31536000, immutable

# The New Testament, one file per language and about half a megabyte apiece.
# There was a rule for v1 and never one for v2, so from the day the bundles
# were bumped they matched nothing here, fell through to the default and were
# answered uncached: a reader who opened a reading in his own language fetched
# the whole New Testament again every visit. v3 is added with v2 so the same
# cannot happen twice.
#
# Safe to hold for a year because the filename carries the version - and only
# because each file was confirmed to answer through a cache-busting query
# string before any page was pointed at it. A request for one the edge does
# not have yet is answered with the whole of index.html and a 200, and that
# answer would then be held here for a year.
/data/bible.v4.*
  Cache-Control: public, max-age=31536000, immutable

# Frozen, not dead: pages held from before a bump still ask for these names.
# v3 was current for a few hours on 23 August and some readers will hold it.
/data/bible.v3.*
  Cache-Control: public, max-age=31536000, immutable

/data/bible.v2.*
  Cache-Control: public, max-age=31536000, immutable

/data/search-index.v9.json
  Cache-Control: public, max-age=31536000, immutable

/data/search-index.v8.json
  Cache-Control: public, max-age=31536000, immutable

/data/search-index.v7.json
  Cache-Control: public, max-age=31536000, immutable

/data/search-index.v6.json
  Cache-Control: public, max-age=31536000, immutable

# Frozen. Pages held from before the bump still ask for this exact name.
/data/search-index.v5.json
  Cache-Control: public, max-age=31536000, immutable

# The words the shared chrome says, in each language. English is inside the
# shared script and needs no file; the English file here is the sheet a
# translator copies. Versioned, so it can be cached hard.
/data/ui-i18n.v5.*
  Cache-Control: public, max-age=31536000, immutable

# Frozen, not dead: each was served immutable for a year, so pages held from
# before a bump still ask for that exact name. Never edit them.
#
# v4 is frozen for a harder reason than the rest. Only three of its names were
# ever written, and the site answers a path that does not exist with the whole
# of the calendar and a 200, so the other nineteen names hold thirteen
# megabytes of index.html in every cache that asked for one. That is why the
# words arrive under v5 rather than being written into v4.
/data/ui-i18n.v4.*
  Cache-Control: public, max-age=31536000, immutable

/data/ui-i18n.v3.*
  Cache-Control: public, max-age=31536000, immutable

/data/ui-i18n.v2.*
  Cache-Control: public, max-age=31536000, immutable

/data/ui-i18n.v1.*
  Cache-Control: public, max-age=31536000, immutable

# v1 to v4 are frozen, not dead. Each was served immutable for a year, so a
# browser that has already fetched one will keep it, and pages held from before
# the shared script was bumped still ask for that exact name. Leaving them in
# place costs 300 KB apiece and means those pages get a working palette with
# slightly older results, instead of the 6.8 MB catch-all. Never edit them:
# bump the version.
/data/search-index.v4.json
  Cache-Control: public, max-age=31536000, immutable

/data/search-index.v3.json
  Cache-Control: public, max-age=31536000, immutable

/data/search-index.v2.json
  Cache-Control: public, max-age=31536000, immutable

/data/search-index.v1.json
  Cache-Control: public, max-age=31536000, immutable

/data/prayers.v2.json
  Cache-Control: public, max-age=31536000, immutable

/data/glossary.v4.json
  Cache-Control: public, max-age=31536000, immutable

# Frozen, not dead: served immutable for a year, so pages held from before
# the bump still ask for that exact name.
/data/glossary.v3.json
  Cache-Control: public, max-age=31536000, immutable

/data/glossary.v2.json
  Cache-Control: public, max-age=31536000, immutable

/data/glossary-i18n.v1.*
  Cache-Control: public, max-age=31536000, immutable

# The flags in the language picker. Versioned, so safe to hold for a year;
# v2 changed Swahili's flag from Tanzania to Kenya, where the Patriarchate of
# Alexandria's Swahili-speaking flock and its seminary mostly are.
/data/flags.v2.json
  Cache-Control: public, max-age=31536000, immutable

# Frozen, not dead: served immutable for a year, so pages held from before
# the bump still ask for this exact name.
/data/flags.v1.json
  Cache-Control: public, max-age=31536000, immutable

/data/rule-i18n.v4.*
  Cache-Control: public, max-age=31536000, immutable

# Frozen, not dead: each was served immutable for a year, so pages held
# from before a bump still ask for that exact name. Never edit them.
/data/rule-i18n.v3.*
  Cache-Control: public, max-age=31536000, immutable

/data/rule-i18n.v2.*
  Cache-Control: public, max-age=31536000, immutable

/data/rule-i18n.v1.*
  Cache-Control: public, max-age=31536000, immutable

# The list of languages the Rule page offers. It grows as languages are added
# and its name is fixed in the page, so it must NOT be immutable - and it must
# not match the rule above, or Cloudflare concatenates both values into one
# malformed header. Hence the different stem.
/data/rule-langs.json
  Cache-Control: public, max-age=3600, must-revalidate

# The library catalogue grows as works are added and its filename is
# hardcoded in library.html, so it must NOT be immutable.
/data/library/*
  Cache-Control: public, max-age=3600, must-revalidate

# The saints' names, vocabulary and lives. Forty megabytes across ten
# languages, and until now they carried no rule at all, so every one of them
# was answered max-age=0, must-revalidate and fetched again on every visit: a
# reader of the Russian pulled five megabytes each time he opened the page.
#
# They are NOT immutable, though their names carry a version. The version is
# per family and not per language, so a language finishing - or a correction
# to one already published, of which there has been one of two hundred and
# thirty-five entries - changes a file without changing its name. An hour is
# the balance: a reader's own visit is cached, and a repair reaches everyone
# within the hour. It is the rule the library catalogue has, for the same
# reason.
# The day-panel entries, one file to a language, lifted out of index.html
# where they were two thirds of the page and every reader was sent all
# twenty-one. Revalidating rather than immutable, like the vocabulary and the
# lives beside them: a language's file is rewritten when that language is
# written, and an hour is soon enough for that to reach anybody.
# The King James New Testament, taken out of index.html where it was inlined
# for the sake of resolving a reading's reference. Versioned, so safe to hold
# for a year.
# The English Bible the calendar quotes. v2 adds the eighteen Old Testament
# books the Western-rite lectionary cites, which were left inside index.html
# when v1 was lifted and were then thrown away on every load, because
# loadBibleEn replaced the object rather than merging into it.
/data/bible-en.v2.json
  Cache-Control: public, max-age=31536000, immutable

# Frozen. Pages held from before the bump still ask for this exact name.
/data/bible-en.v1.json
  Cache-Control: public, max-age=31536000, immutable

/data/saint-info.v1.*
  Cache-Control: public, max-age=3600, must-revalidate

/data/saint-terms.v5.*
  Cache-Control: public, max-age=3600, must-revalidate

/data/saint-lives.v6.*
  Cache-Control: public, max-age=3600, must-revalidate

/data/saint-names.v1.*
  Cache-Control: public, max-age=3600, must-revalidate

# Scripture is large and stable but carries no version in the filename.
/scripture/*
  Cache-Control: public, max-age=604800

# The shared UI layer carries a version in its filename, so it can be cached
# hard: a change ships as a new filename and no cached copy can be stale. Bump
# the version in the filename AND in all seven pages together - an unversioned
# asset behind a long edge cache is what hid the flag picker from readers for
# a day, and shortening the header does not purge what Cloudflare has already
# cached.
#
# assets/plithos-ui.js is the one deliberate exception: it is unversioned
# because pages held from an earlier day ask for that exact name, and those
# pages cannot be changed. It does nothing but bring such a page up to date.
#
# The year is a loaded gun while a deploy is landing. A request for a file the
# edge does not have yet is answered with the whole of index.html and a 200,
# and that answer is then held here for a year - which is how v3.css was lost
# a minute after it shipped. Ship the file in one commit, confirm it answers
# through a cache-busting query string, and point the pages at it in the next.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=2592000

/*.svg
  Cache-Control: public, max-age=2592000
